{
  "name": "eco-manage",
  "private": true,
  "version": "1.0.0",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "start": "concurrently \"npm run dev\" \"wait-on tcp:127.0.0.1:5173 && npm run electron:dev\"",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "test": "vitest",
    "start:cloud": "node server.js",
    "build:exe": "electron-builder -w"
  },
  "build": {
    "appId": "com.ecomanage.app",
    "productName": "Eco-Manage",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "icon": "build/icon.png"
    },
    "files": [
      "dist/**/*",
      "electron/main.js"
    ]
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.0",
    "@capacitor/android": "^8.4.0",
    "@capacitor/core": "^8.3.3",
    "@capacitor/geolocation": "^8.2.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.0.0",
    "body-parser": "^2.2.2",
    "clsx": "^2.1.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "i18next": "^23.10.0",
    "i18next-browser-languagedetector": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.1.0",
    "react-router-dom": "^6.22.2",
    "tailwind-merge": "^2.2.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.0",
    "@electron/rebuild": "^3.6.0",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "electron": "^29.1.0",
    "electron-builder": "^26.8.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.4",
    "vitest": "^1.3.1",
    "wait-on": "^7.2.0"
  }
}
